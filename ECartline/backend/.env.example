# Copy this file to ".env" and fill in your own values.
PORT=3000

# --- MySQL / XAMPP (MariaDB) ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
# In XAMPP, root password is empty by default (leave blank). If you set a password, enter it here.
DB_PASSWORD=
DB_NAME=ecartline

# --- Login token secret: put any long random text here ---
JWT_SECRET=change_this_to_a_long_random_text
JWT_EXPIRES_IN=7d

# --- First admin account (created by "npm run setup") ---
ADMIN_NAME=ECartline Admin
ADMIN_EMAIL=admin@ecartline.in
ADMIN_PASSWORD=Admin@12345

# Optional: only if you open the frontend from another address (e.g. VS Code Live Server)
# CORS_ORIGIN=http://127.0.0.1:5500,http://localhost:5500
